PORT=
# Use `localhost` no host do banco: é o valor que serve o `pnpm dev`. Rodando em
# container, o `pnpm docker:run` sobrescreve esta chave sozinho, com
# `host.docker.internal` — `localhost` lá dentro seria o próprio container.
DATABASE_URL=
# Sem aspas nos valores: o `--env-file` do Docker não as remove e elas entrariam
# no valor, reprovando na validação do Zod. O do Node aceita os dois formatos.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET=
CLOUDFLARE_PUBLIC_URL=
# Origem liberada no CORS. Em dev pode ficar vazia (usa o default localhost:5300).
WEB_URL=
